# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Values in real environment variables win over values in .env.

# Required. Google Places API (New) key.
# Get it in the Google Cloud Console: APIs & Services > Credentials.
# Enable "Places API (New)" for the project first. https://console.cloud.google.com/
GOOGLE_PLACES_KEY=your-google-places-api-key

# Optional. Only used with "run.py --brave-min-dealer N".
# Get it in the Brave Search API dashboard: https://api-dashboard.search.brave.com/
BRAVE_API_KEY=your-brave-search-api-key

# Optional. Default search center (decimal degrees). Default: Hamburg city center.
# The --lat and --lon command line options override these values.
HANDSCHLAG_LAT=53.5511
HANDSCHLAG_LON=9.9937
